# modbus_rules.rules — ASCEND-PG v2 testbed (Suricata IDS detection layer)
# Custom Suricata rules for detecting the testbed's recon + attack traffic.
# Syntax verified against Suricata's documented `modbus` keyword — test with
# `sudo suricata -T -c /etc/suricata/suricata.yaml -v` before relying on it,
# since exact behavior can still vary slightly by Suricata version.
#
# REQUIRES: app-layer.protocols.modbus.enabled: yes and
#           detection-ports.dp: 502 set in suricata.yaml (see docs/suricata_setup.md)
#
# NOTE: Suricata is the detection component for this real-testbed checkpoint.
# The project's trained LSTM/Autoencoder detectors (detection/lstm_detector.py,
# autoencoder_detector.py, fusion.py — §5 of the master file) remain the final
# deliverable; these signatures give a working, real-IDS ground truth now.
#
# SID allocation: 9000001–9000025 reserved for ASCEND-PG testbed rules.
# (SIDs 9000003, 9000011–9000019, 9000021 are unused/reserved)

# ===== FDI / RESPONSE INJECTION (T0836) — writes to holding registers =====
# Flags any write to a Holding Register — matches fdi_attack.py,
# naive_response_injection.py, and complex_response_injection.py.
alert modbus any any -> any 502 (msg:"ASCEND-PG FDI - Holding Register Write (T0836)"; modbus: access write holding; classtype:attempted-admin; sid:9000001; rev:2;)

# ===== DoS (T0814) — Modbus request flood =====
# Suricata ships a built-in Modbus flood event (modbus.flooded) — reuse it.
# Detects both dos_attack.py (request flood) and sustained connection exhaustion.
alert modbus any any -> any any (msg:"ASCEND-PG DoS - Modbus Request Flood (T0814)"; flow:to_server; app-layer-event:modbus.flooded; classtype:attempted-dos; sid:9000002; rev:1;)

# ===== RECON — Device ID Query (T0888) =====
# Function 43 (0x2B) = Read Device Identification — rare in normal polling.
alert modbus any any -> any 502 (msg:"ASCEND-PG Recon - Modbus Device ID Query (T0888)"; modbus: function 43; classtype:attempted-recon; sid:9000004; rev:2;)

# ===== RECON — Function Code Scan (T0840) =====
# Rapid sequence of different function codes from the same source indicates
# function code scanning/fingerprinting. Detecting FC07 (Read Exception Status)
# and FC08 (Diagnostics) — both are uncommon in normal SCADA polling.
alert modbus any any -> any 502 (msg:"ASCEND-PG Recon - Read Exception Status FC07 (T0840)"; modbus: function 7; classtype:attempted-recon; sid:9000005; rev:1;)
alert modbus any any -> any 502 (msg:"ASCEND-PG Recon - Diagnostics FC08 (T0840)"; modbus: function 8; classtype:attempted-recon; sid:9000006; rev:1;)

# ===== COMMAND INJECTION — Coil Writes (T0855) =====
# Any write to coils — matches cmd_inject_coil.py (FC05/FC15).
# In a normal SCADA polling cycle, coil writes are rare and indicate
# unauthorized actuator control.
alert modbus any any -> any 502 (msg:"ASCEND-PG CmdInject - Coil Write (T0855)"; modbus: access write coils; classtype:attempted-admin; sid:9000007; rev:1;)

# ===== COMMAND INJECTION — Malicious Function Codes (T0855) =====
# FC08 sub-function 0x0001 (Restart Communications) is a diagnostic
# function that can reset PLC comms — highly suspicious in production.
# (FC08 generic already caught by sid:9000006 above, this is the
# specific dangerous sub-function)
alert modbus any any -> any 502 (msg:"ASCEND-PG CmdInject - Diagnostics Restart FC08 (T0855)"; modbus: function 8, subfunction 1; classtype:attempted-admin; sid:9000008; rev:1;)
alert modbus any any -> any 502 (msg:"ASCEND-PG CmdInject - Diagnostics Clear Counters FC08 (T0855)"; modbus: function 8, subfunction 10; classtype:attempted-admin; sid:9000009; rev:1;)

# ===== MITM (T0830) — non-standard port detection =====
# A transparent TCP proxy (mitm_proxy.py on :503) forwards modified
# responses. SID 9000022 matches raw TCP payload with MBAP-like header
# on port 503. True modification detection requires the trained
# LSTM/Autoencoder detectors.

# ===== REPLAY (T0832) — not rule-detectable =====
# Replayed Modbus traffic is byte-identical to legitimate traffic at the
# signature level. Detection requires sequence-number/timing anomaly
# analysis — exactly the kind of case the trained LSTM/Autoencoder
# detectors are meant to cover.

# ===== DoS — Connection Exhaustion (T0814) =====
# Many simultaneous TCP connections without Modbus requests trigger
# Suricata's connection tracking limits. The modbus.flooded event
# (sid:9000002) may also fire. Additional TCP-level detection:
alert tcp any any -> any 502 (msg:"ASCEND-PG DoS - Rapid TCP SYN to Modbus (T0814)"; flags:S; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-dos; sid:9000010; rev:1;)

# ===== DoS — Sub-Threshold Read Flood (T0814) =====
# Detects dos_quiet: 100 FC03 reads in 5s on one connection.
# Falls below modbus.flooded threshold (500) so uses rate-based detection.
alert modbus any any -> any 502 (msg:"ASCEND-PG DoS - Sub-Threshold Read Flood (T0814)"; flow:to_server, established; dsize:<20; threshold:type both, track by_src, count 50, seconds 5; classtype:attempted-dos; sid:9000020; rev:1;)

# ===== MITM — Modbus on Non-Standard Port 503 (T0830) =====
# mitm_proxy.py listens on TCP 503 and forwards to PLC on 502.
# Suricata's Modbus decoder only inspects detection-ports 502, so
# match on raw TCP payload with MBAP-like header at non-standard port.
alert tcp any any -> any 503 (msg:"ASCEND-PG MITM - Modbus on Non-Standard Port 503 (T0830)"; flow:to_server, established; dsize:<50; content: "|00 00|"; offset:2; depth:2; content: "|00 00|"; offset:4; depth:2; content: "|03|"; offset:7; depth:1; classtype:policy-violation; sid:9000022; rev:1;)

# ===== Brute Force — Rapid Register Enumeration (T0806) =====
# brute_force_io.py sends 200 FC03 reads cycling registers 0-99 in 2s.
# Below modbus.flooded threshold; detected by rate.
alert modbus any any -> any 502 (msg:"ASCEND-PG BruteForce - Rapid Register Enumeration (T0806)"; flow:to_server, established; dsize:<20; threshold:type both, track by_src, count 50, seconds 3; classtype:attempted-recon; sid:9000023; rev:1;)

# ===== Denial of View — Forged FC06 Response (T0815) =====
# denial_of_view.py sends forged FC06 writes to SCADA host.
# Raw byte match as fallback when Suricata's Modbus decoder rejects
# unsolicited responses (no matching request in TCP flow state).
alert tcp any any -> any 502 (msg:"ASCEND-PG DoV - Forged FC06 Write (T0815)"; flow:to_server, established; dsize:12; content: "|00 00|"; offset:2; depth:2; content: "|00|"; offset:6; depth:1; content: "|06|"; offset:7; depth:1; classtype:attempted-admin; sid:9000024; rev:1;)

# ===== Recon — Coil Read (T0801) =====
# detect coil reads (FC01) — uncommon in normal SCADA polling.
# Catches manipulate_io_image.py Phase 1 reads before writes.
alert modbus any any -> any 502 (msg:"ASCEND-PG Recon - Coil Read FC01 (T0801)"; modbus: function 1; classtype:attempted-recon; sid:9000025; rev:1;)

# ===== Remote Services (T0886) — SSH to OT-zone hosts =====
# remote_services.py pivots via SSH to dual-homed SCADA host, then
# reaches PLCs on port 502. Detect SSH connections to OT-zone hosts.
alert tcp any any -> any 22 (msg:"ASCEND-PG Remote Services - SSH to OT Host (T0886)"; flags:S; threshold:type both, track by_src, count 3, seconds 60; classtype:attempted-lateral-movement; sid:9000026; rev:1;)

# ===== Automated Collection (T0802) — Broad register scan =====
# automated_collection.py scans all PLCs reading holding/input registers
# and coils. High-volume Modbus reads from non-SCADA source.
alert modbus any any -> any 502 (msg:"ASCEND-PG AutoCollection - Broad Register Scan (T0802)"; flow:to_server, established; dsize:<20; threshold:type both, track by_src, count 30, seconds 5; classtype:attempted-recon; sid:9000027; rev:1;)

# ===== Standard App Layer Protocol C2 (T0869) — Suspicious register writes =====
# standard_protocol_c2.py embeds C2 commands in Modbus register values.
# Detect repeated writes to C2 command register range (40100-40110).
alert modbus any any -> any 502 (msg:"ASCEND-PG C2 - Suspicious Register Write Pattern (T0869)"; modbus: access write holding; threshold:type both, track by_src, count 10, seconds 5; classtype:command-and-control; sid:9000028; rev:1;)

# ===== Alarm Suppression (T0878) — Alarm register clear =====
# alarm_suppression.py writes zeros to alarm registers (40050-40099).
# Detect rapid writes to alarm register range from non-SCADA source.
alert modbus any any -> any 502 (msg:"ASCEND-PG AlarmSupp - Alarm Register Clear (T0878)"; modbus: access write holding; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-admin; sid:9000029; rev:1;)

# ===== Service Stop (T0881) — Invalid function code flood =====
# service_stop.py floods PLC with invalid/unsupported function codes.
# Detect function code 127 (always unsupported) and malformed packets.
alert modbus any any -> any 502 (msg:"ASCEND-PG ServiceStop - Invalid Function Code Flood (T0881)"; modbus: function 127; classtype:attempted-admin; sid:9000030; rev:1;)
